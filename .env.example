# ── Set these on the RunPod Pod (Pod → Edit → Environment Variables) ──────────

# REQUIRED. Long random secret shared with the Autoscio backend (GPU_WORKER_API_KEY).
# Authenticates the backend's requests AND signs this worker's webhooks.
# Generate one with:  openssl rand -hex 32
WORKER_API_KEY=

# Where model weights are cached. Keep it on the Pod's /workspace volume so a
# restart does not re-download ~35 GB.
MODELS_DIR=/workspace/models

# Optional. Only needed if Hugging Face rate-limits anonymous downloads.
HF_TOKEN=

# ── Tuning (defaults are right for one RTX 4090) ──────────────────────────────

# LTX-Video model: 2B distilled fits a 24 GB GPU next to Chatterbox.
# ltxv-13b-0.9.8-distilled.yaml is higher quality but needs a 48 GB+ GPU (L40S/A6000).
LTX_PIPELINE_CONFIG=ltxv-2b-0.9.8-distilled.yaml
# 1 (default) parks the text encoder in CPU RAM during generation. Needed on 24 GB.
LTX_OFFLOAD_TO_CPU=1
LTX_LONG_EDGE=960
LTX_FPS=24
# Longest clip; 5 s fits a 24 GB GPU next to Chatterbox. Use more clips for longer videos.
LTX_MAX_SECONDS=5

CHATTERBOX_T3_MODEL=v3
CHATTERBOX_CHUNK_CHARS=250

# Run only one model on this Pod: tts | video | tts,video
ENABLED_RUNNERS=tts,video
RUNNER_TIMEOUT_SECONDS=1800
MAX_QUEUE=100
